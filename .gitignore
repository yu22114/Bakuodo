# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude（worktreeと個人設定はローカルだけ。共有するのは設定とフックだけ）
.claude/*
!.claude/settings.json
!.claude/hooks/

# UXリサーチ用ドキュメント（ローカルのみ・リポジトリには含めない）
/research/

# Capacitor / Xcode（iOSアプリの殻）
ios/App/build/
ios/App/Pods/
ios/DerivedData/
ios/.xcode.env.local
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
